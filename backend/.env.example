# Copy to .env and adjust. Never commit real secrets.
# LOCAL DEV defaults below. For PRODUCTION (Railway + startdownloading.com),
# set in the Railway service Variables panel (not in a file):
#   NODE_ENV=production
#   CORS_ORIGINS=https://startdownloading.com
#   PORT=<provided by Railway via $PORT automatically — do not set manually>
#   YTDLP_BIN=yt-dlp
#   TEMP_DIR=./temp
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (dev default allows the static frontend below)
# PROD: CORS_ORIGINS=https://startdownloading.com (never * — see DEPLOY.md)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Path to the yt-dlp executable (download engine). Must be a bare name or an
# absolute path (no shell metacharacters). If missing/unset, /api/download
# returns an honest 502 PROCESSING_FAILED instead of faking a download.
YTDLP_BIN=yt-dlp
# Optional absolute directory containing ffmpeg/ffprobe, passed to the engine
# as --ffmpeg-location (useful for local dev without PATH changes).
# Example (Windows): FFMPEG_LOCATION=C:\ffmpeg\bin
FFMPEG_LOCATION=
# Controlled temporary directory for processed files
TEMP_DIR=./temp
# Safety limits (bytes / ms / count)
MAX_DOWNLOAD_BYTES=536870912
DOWNLOAD_TIMEOUT_MS=120000
MAX_CONCURRENT_JOBS=2
MAX_BODY_BYTES=1048576
# General API budget (all /api routes)…
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# …plus a separate stricter budget for the expensive POST /api/download
RATE_LIMIT_DOWNLOAD_WINDOW_MS=60000
RATE_LIMIT_DOWNLOAD_MAX=10
# …plus a light budget for cheap content pages (homepage, downloaders, guides)
RATE_LIMIT_SITE_WINDOW_MS=60000
RATE_LIMIT_SITE_MAX=300
# Completed files are kept this long before cleanup (ms); also the max age
# swept by the startup + periodic stale-file cleanup job
FILE_TTL_MS=600000
